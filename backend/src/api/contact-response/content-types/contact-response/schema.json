{
  "kind": "collectionType",
  "collectionName": "contact_responses",
  "info": {
    "singularName": "contact-response",
    "pluralName": "contact-responses",
    "displayName": "Contact Response"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phoneNumber": {
      "type": "biginteger",
      "required": false,
      "max": "10"
    },
    "subject": {
      "type": "text",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    }
  }
}
